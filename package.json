{
  "name": "fanatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:ai-evals": "vitest run src/lib/fanAtlasAIEvaluations.test.ts",
    "test:ai-coordination": "vitest run src/server/ai/aiCoordinationStore.test.ts src/lib/fanAtlasAIServer.test.ts",
    "test:ai-coordination:live": "node scripts/live-ai-coordination.mjs all",
    "test:ai-coordination:idempotency-stress": "node scripts/live-ai-coordination.mjs idempotency-stress 5",
    "check:ai-idempotency-definition": "node scripts/live-ai-coordination.mjs idempotency-definition",
    "test:ai-tools": "vitest run src/server/tools/toolExecutor.test.ts src/lib/fanAtlasAIServer.test.ts",
    "check:ai-coordination": "node scripts/live-ai-coordination.mjs check",
    "check:ai-release-gate": "node scripts/check-ai-release-gate.mjs",
    "check:ai-internal-activation": "node scripts/check-ai-internal-activation.mjs",
    "check:ai-provider": "node scripts/check-ai-provider.mjs",
    "test:ai-internal-live": "node scripts/internal-ai-live-sessions.mjs",
    "repair:ai-coordination-grants": "node scripts/repair-ai-coordination-grants.mjs",
    "e2e:auth:setup": "node scripts/e2e-auth-setup.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:authenticated": "playwright test tests/e2e/authenticated-ai.spec.ts tests/e2e/authenticated-private-routes.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run test:ai-evals && npm run build",
    "validate:full": "npm run validate && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/leaflet": "^1.9.12",
    "@vitejs/plugin-react": "^4.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "jsdom": "24.1.3",
    "typescript-eslint": "8.46.4",
    "vitest": "2.1.9"
  }
}
